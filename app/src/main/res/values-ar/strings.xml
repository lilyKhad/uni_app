    <!-- Department descriptions -->
    <string name="dept_physics_desc">تعرّف على القوانين الأساسية للمادة والطاقة، من المواد والإشعاع إلى أنظمة الطاقة والتطبيقات الطبية.</string>
    <string name="dept_chemistry_desc">ادرس تركيب المادة وخصائصها وتحولاتها، مع تطبيقات في المواد والبيئة والتحليل والصيدلة.</string>
    <string name="dept_biology_desc">ادرس الكائنات الحية من الجزيئات والخلايا إلى الكائن كاملاً، مع تكوين في الكيمياء الحيوية والوراثة والفيزيولوجيا.</string>
    <string name="dept_agronomy_desc">ادرس الإنتاج النباتي والحيواني وحماية المحاصيل لدعم الفلاحة المستدامة.</string>
    <string name="dept_staps_desc">تكوّن في التربية البدنية والتدريب الرياضي وعلوم الحركة الإنسانية لمهن التعليم والتدريب.</string>
    <string name="dept_mechanical_desc">تعلّم تصميم الأنظمة الميكانيكية وإنجازها وصيانتها، مع التركيز على البناء الميكانيكي والطاقة والتصنيع.</string>
    <string name="dept_civil_desc">تعلّم تصميم وإنجاز المنشآت والأساسات والبنى التحتية مثل المباني والطرق والجسور.</string>
    <string name="dept_electrical_desc">ادرس الطاقة الكهربائية والآلات الكهربائية والتحكم الآلي في الأنظمة الصناعية.</string>
    <string name="dept_process_desc">ادرس العمليات الكيميائية والصناعية وكيفية تحويل المواد الأولية إلى منتجات بأمان وكفاءة.</string>
    <string name="dept_earthquake_desc">ادرس الظواهر الزلزالية والجيوفيزياء لفهم باطن الأرض ومخاطر الزلازل.</string>
    <string name="dept_transport_desc">ادرس التجهيزات الميكانيكية والأنابيب المستعملة في استخراج المحروقات ونقلها وتوزيعها.</string>
    <string name="dept_chem_pharma_desc">ادرس التكرير والعمليات البتروكيميائية والأمن الصناعي في صناعات الطاقة والكيمياء.</string>
    <string name="dept_automation_desc">ادرس التحكم الآلي والكهرباء الصناعية والقياس الآلي لمنشآت النفط والغاز والبتروكيمياء.</string>
    <string name="dept_mining_desc">ادرس استكشاف حقول النفط والمعادن وحفرها وإنتاجها.</string>
    <string name="dept_hydro_economics_desc">ادرس اقتصاد النفط والغاز وأسواقهما، من الأسعار والاستثمار إلى سياسة الطاقة.</string>
    <string name="dept_public_law_desc">ادرس الدولة ومؤسساتها والقانون الإداري المنظم للعلاقات بين السلطات العامة والمواطنين.</string>
    <string name="dept_private_law_desc">ادرس القانون المدني وقانون الأعمال المنظمين للعلاقات بين الأفراد والشركات.</string>
    <string name="dept_political_science_desc">ادرس الأنظمة السياسية والعلاقات الدولية والإدارة العامة.</string>
    <string name="dept_arabic_desc">ادرس اللغة العربية والنقد الأدبي والأدب العربي القديم والحديث.</string>
    <string name="dept_french_desc">ادرس اللغة الفرنسية وآدابها وحضارتها وعلوم اللغة.</string>
    <string name="dept_english_desc">ادرس اللغة الإنجليزية وآدابها وحضارتها وعلوم اللغة.</string>
    <string name="dept_management_desc">ادرس كيفية تسيير المنظمات، من التسيير وريادة الأعمال إلى التسيير المالي.</string>
    <string name="dept_commercial_desc">ادرس التسويق والتجارة والتجارة الدولية للتحضير لمهن الأعمال.</string>
    <string name="dept_economics_desc">ادرس النظرية الاقتصادية والأساليب الكمية وسير الأسواق والمؤسسات.</string>
    <string name="dept_finance_desc">ادرس المحاسبة والتدقيق والمالية، بما في ذلك البنوك والتأمين ومالية المؤسسة.</string>

