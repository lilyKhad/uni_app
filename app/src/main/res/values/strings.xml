    <!-- Department descriptions -->
    <string name="dept_physics_desc">Study the fundamental laws of matter and energy, from materials and radiation to energy systems and medical applications.</string>
    <string name="dept_chemistry_desc">Study the composition, properties and transformations of matter, with applications in materials, environment, analysis and pharmaceuticals.</string>
    <string name="dept_biology_desc">Study living organisms from molecules and cells to whole organisms, with training in biochemistry, genetics and physiology.</string>
    <string name="dept_agronomy_desc">Study plant and animal production and the protection of crops to support sustainable agriculture.</string>
    <string name="dept_staps_desc">Train in physical education, sports training and the science of human movement, for teaching and coaching careers.</string>
    <string name="dept_mechanical_desc">Learn to design, build and maintain mechanical systems, with a focus on construction, energy and manufacturing.</string>
    <string name="dept_civil_desc">Learn to design and build structures, foundations and infrastructure such as buildings, roads and bridges.</string>
    <string name="dept_electrical_desc">Study electrical power, electrical machines, automation and control of industrial systems.</string>
    <string name="dept_process_desc">Study chemical and industrial processes: how raw materials are transformed into products safely and efficiently.</string>
    <string name="dept_earthquake_desc">Study seismic phenomena and geophysics to understand the subsurface and the risks of earthquakes.</string>
    <string name="dept_transport_desc">Study the mechanical equipment and pipelines used to extract, transport and distribute hydrocarbons.</string>
    <string name="dept_chem_pharma_desc">Study refining, petrochemical processes and industrial safety applied to the energy and chemical industries.</string>
    <string name="dept_automation_desc">Study automatic control, industrial electricity and instrumentation for oil, gas and petrochemical plants.</string>
    <string name="dept_mining_desc">Study the exploration, drilling and production of oil and mineral deposits.</string>
    <string name="dept_hydro_economics_desc">Study the economics and markets of oil and gas, from pricing and investment to energy policy.</string>
    <string name="dept_public_law_desc">Study the state, its institutions and the administrative law that regulates relations between public authorities and citizens.</string>
    <string name="dept_private_law_desc">Study the civil and business law that governs relations between individuals and companies.</string>
    <string name="dept_political_science_desc">Study political systems, international relations and public administration.</string>
    <string name="dept_arabic_desc">Study the Arabic language, literary criticism and classical and modern Arabic literature.</string>
    <string name="dept_french_desc">Study the French language, its literature and civilization, and the sciences of language.</string>
    <string name="dept_english_desc">Study the English language, its literature and civilization, and the sciences of language.</string>
    <string name="dept_management_desc">Study how organizations are run, from management and entrepreneurship to financial management.</string>
    <string name="dept_commercial_desc">Study marketing, trade and international commerce to prepare for careers in business.</string>
    <string name="dept_economics_desc">Study economic theory, quantitative methods and the functioning of markets and businesses.</string>
    <string name="dept_finance_desc">Study accounting, auditing and finance, including banks, insurance and corporate finance.</string>

